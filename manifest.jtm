# MANIFEST.jtm

# extradata:
author: "Peter Helmut Wohlfarth"
release-date: "--.--.--"
description: "This language is the main language of the jitrannetwork."

# language - jigsawscript -
id: "jigsawscript"
version: 1.0
language-concept: "Pydalo/jigo.jtlc"
