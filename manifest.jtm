# transpiler-meta:
language-concept-version: 1.0
transpiler-version: 1.0
supported-backends: *
default-backend: "java"
keywords:
  - "highlevel"
  - "jigsawscript"  

# looking for mylang here:
homepage: "https://funlanguage/this/page/not/exists"
repository: "Pydalo/jigsawscript.jtlm"
